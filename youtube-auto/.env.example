# OpenAI API キー（DALL-E 3 画像生成用）
OPENAI_API_KEY=sk-...

# Anthropic API キー（台本生成用）
ANTHROPIC_API_KEY=sk-ant-...

# VOICEVOX エンジン URL（ローカルで起動した場合）
VOICEVOX_URL=http://localhost:50021

# VOICEVOX 話者 ID（0=四国めたん, 1=ずんだもん, 2=春日部つむぎ など）
VOICEVOX_SPEAKER=1

# 動画出力先フォルダ
OUTPUT_DIR=output

# 動画タイトル接頭辞
VIDEO_TITLE_PREFIX=【金持ちの習慣】
